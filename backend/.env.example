PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://mentor:mentor@localhost:5432/mentor
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=*
AUTH_RATE_MAX=20

# ---- AI ----
# Leave AI_MODEL / AI_API_KEY empty to get safe mock tutor replies.
#
# OPTION 1: Ollama cloud (uses your Ollama API key)
#   AI_PROVIDER=ollama
#   AI_BASE_URL=https://ollama.com
#   AI_API_KEY=paste-your-ollama-key-here
#   AI_MODEL=<a cloud model name from ollama.com>
#
# OPTION 2: Ollama on your PC (no key needed)
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434          (backend in Docker: http://host.docker.internal:11434)
#   AI_MODEL=<a model you pulled, e.g. via: ollama pull <name>>
#
# OPTION 3: Anthropic
#   AI_PROVIDER=anthropic   AI_API_KEY=...   AI_MODEL=...
AI_PROVIDER=ollama
AI_BASE_URL=https://ollama.com
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash

