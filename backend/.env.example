PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://mentor:mentor@localhost:5432/mentor
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=*
AUTH_RATE_MAX=20

# ---- AI (keys intentionally EMPTY) ----
# While AI_API_KEY is empty the API returns safe mock tutor replies.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.anthropic.com

# Optional: create an admin user when you run `npm run db:init`
ADMIN_EMAIL=
ADMIN_PASSWORD=
